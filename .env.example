# Copy this file to .env and replace the placeholder values before taking real orders.

DATABASE_URL="file:./dev.db"

# Owner login. Prefer a scrypt hash so the password is not stored in plaintext.
# Create one with: npm run hash-password
# Format: scrypt$<saltHex>$<hashHex>
# Salt is the hex string itself (UTF-8), from crypto.scryptSync(password, salt, 64).
# Escape each $ as \$ in this file. Next treats $name as another variable and would wipe the hash.
# ADMIN_PASSWORD_HASH="scrypt\$0123456789abcdef0123456789abcdef\$<128 hex chars>"
ADMIN_PASSWORD_HASH=""
# Used only when ADMIN_PASSWORD_HASH is empty. The sample value is for local setup.
ADMIN_PASSWORD="noorandaaz-admin"
# Any long random string. Changing it signs everyone out.
SESSION_SECRET="change-this-to-a-long-random-string"

# Public site URL used in links, WhatsApp messages, and SEO.
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3847"

# WhatsApp number in international form, digits only. No plus sign.
NEXT_PUBLIC_WHATSAPP_NUMBER="923001234567"
NEXT_PUBLIC_WHATSAPP_DISPLAY="0300 1234567"
NEXT_PUBLIC_CONTACT_EMAIL="hello@noorandaaz.pk"

# Manual payment accounts. These defaults are placeholders.
NEXT_PUBLIC_JAZZCASH_NUMBER="0300-1234567"
NEXT_PUBLIC_JAZZCASH_TITLE="Noorandaaz"
NEXT_PUBLIC_EASYPAISA_NUMBER="0301-7654321"
NEXT_PUBLIC_EASYPAISA_TITLE="Noorandaaz"
NEXT_PUBLIC_BANK_NAME="Habib Bank Limited (HBL)"
NEXT_PUBLIC_BANK_TITLE="Noorandaaz"
NEXT_PUBLIC_BANK_ACCOUNT="1234-5678901234"
NEXT_PUBLIC_BANK_IBAN="PK00HABB0000001234567890"

# Whole rupees.
NEXT_PUBLIC_DELIVERY_FEE="250"
NEXT_PUBLIC_FREE_DELIVERY_THRESHOLD="5000"
